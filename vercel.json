{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/media/catalog",
      "destination": "/api/catalog"
    },
    {
      "source": "/api/media-info",
      "destination": "/api/metadata"
    },
    {
      "source": "/api/media/(.*)",
      "destination": "/api/metadata"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

