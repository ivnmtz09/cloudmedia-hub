# ==============================================================================
# CLOUDMEDIA HUB - VARIABLES DE ENTORNO EN VERCEL (100% SERVERLESS)
# Configura estas variables en Vercel -> Settings -> Environment Variables
# ==============================================================================

# 1. GOOGLE DRIVE API v3 (Obligatorio para el catálogo y streaming)
# ID de la carpeta raíz de Google Drive (de la URL: drive.google.com/drive/folders/ID)
GOOGLE_DRIVE_ROOT_FOLDER_ID=1a2b3c4d5e6f7g8h9i0j_ejemplo

# OPCIÓN A: Service Account de Google Cloud (Recomendada para producción):
# (Recuerda compartir tu carpeta de Google Drive con este correo en modo "Lector")
GOOGLE_SERVICE_ACCOUNT_EMAIL=cloudmedia-sa@tu-proyecto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# O el JSON completo de Service Account en una sola variable:
# GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# OPCIÓN B: OAuth2 con Refresh Token de cuenta personal:
# GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=tu_client_secret
# GOOGLE_REFRESH_TOKEN=1//tu_refresh_token

# 2. TMDB API (The Movie Database - Gratuita)
# Para enriquecimiento automático de posters, backdrops, actores y sinopsis
# Obtén tu clave en: https://www.themoviedb.org/settings/api
TMDB_API_KEY=tu_clave_api_tmdb

# 3. GOOGLE GEMINI API (Para CloudMedIA y normalización de nombres)
# Obtén tu clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_clave_api_gemini
GEMINI_MODEL=gemini-2.5-flash

